<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="@drawable/category_complete_selector"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true">

    <!-- Category Name -->
    <TextView
        android:id="@+id/categoryNameText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:text="Category Name"
        android:textColor="@color/category_text_color_selector"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="start"
        android:layout_marginEnd="8dp"/>

    <!-- Category Count Badge -->
    <TextView
        android:id="@+id/categoryCountText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="0"
        android:textSize="16sp"
        android:textColor="@color/category_count_color_selector"
        android:gravity="center"
        android:background="@drawable/count_badge_background_selector"
        android:padding="8dp"
        android:minWidth="40dp"
        android:minHeight="32dp"/>

</LinearLayout>
