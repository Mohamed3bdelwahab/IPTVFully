<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/categoryCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:focusable="true"
    android:clickable="true"
    android:focusableInTouchMode="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardUseCompatPadding="true"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@null"
    app:cardElevation="4dp"
    android:background="@drawable/category_complete_selector">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Category Name Column -->
        <TextView
            android:id="@+id/categoryText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:text="Category"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/category_text_color_selector"
            android:gravity="start"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="16dp" />

        <!-- Series Count Column -->
        <TextView
            android:id="@+id/categoryCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0"
            android:textSize="16sp"
            android:textColor="@color/category_count_color_selector"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/count_badge_background_selector"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:minWidth="32dp"
            android:minHeight="32dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
