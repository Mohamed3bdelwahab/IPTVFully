<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark"
    android:padding="@dimen/screen_padding">

    <!-- App Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NewIPTV V2"
        android:textSize="@dimen/title_text_size"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:layout_marginBottom="@dimen/title_margin_bottom"
        android:fontFamily="sans-serif-light" />

    <!-- Menu Grid with ScrollView for touch support -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        
        <GridLayout
            android:id="@+id/menuGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="@integer/menu_column_count"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="false"
            android:padding="8dp" />
            
    </ScrollView>

    <!-- Instructions for TV Remote -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Use D-Pad to navigate • Enter to select • Back to exit"
        android:textSize="@dimen/instruction_text_size"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginTop="@dimen/instruction_margin_top"
        android:fontFamily="sans-serif" />

</LinearLayout>
