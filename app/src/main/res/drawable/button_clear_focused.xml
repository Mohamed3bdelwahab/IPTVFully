<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_clear_focused_background" />
            <stroke 
                android:width="2dp" 
                android:color="@color/button_clear_focused_border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    
    <!-- Normal state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/button_secondary_background" />
            <stroke 
                android:width="1dp" 
                android:color="@color/button_secondary_border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
