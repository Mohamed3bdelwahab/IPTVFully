<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 🎯 FOCUSED STATE - Beautiful Glowing Effect -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Outer glow effect -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/category_focus_glow" />
                    <corners android:radius="16dp" />
                    <padding
                        android:left="4dp"
                        android:top="4dp"
                        android:right="4dp"
                        android:bottom="4dp" />
                </shape>
            </item>
            
            <!-- Main card background -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="@color/category_focus_color"
                        android:centerColor="@color/focus_gradient_end"
                        android:endColor="@color/category_focus_color"
                        android:angle="45" />
                    <corners android:radius="12dp" />
                    <stroke
                        android:width="3dp"
                        android:color="@color/focus_border_white" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- 🎨 DEFAULT STATE - Subtle Card -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/category_default_bg" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/text_secondary" />
        </shape>
    </item>
    
</selector>
