<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions for video playback -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    
    <!-- Permissions for querying other apps (Android 15+) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" 
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".NewIPTVApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.NewIPTV">
        
        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:resizeableActivity="true"
            android:theme="@style/Theme.NewIPTV.NoActionBar"
            tools:targetApi="24">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Home Screen Activity -->
        <activity
            android:name=".ui.home.HomeScreen"
            android:exported="false"
            android:theme="@style/Theme.NewIPTV.NoActionBar"
            android:screenOrientation="landscape" />
            
        <!-- Series Screen Activity -->
        <activity
            android:name=".ui.series.SeriesScreen"
            android:exported="false"
            android:theme="@style/Theme.NewIPTV.NoActionBar"
            android:screenOrientation="landscape" />
            
        <!-- Series Info Screen Activity -->
        <activity
            android:name=".ui.seriesinfo.SeriesInfoScreen"
            android:exported="false"
            android:theme="@style/Theme.NewIPTV.NoActionBar"
            android:screenOrientation="landscape" />
        
        <!-- Movies Screen Activity -->
        <activity
            android:name=".ui.movies.MoviesScreen"
            android:exported="false"
            android:theme="@style/Theme.NewIPTV.NoActionBar"
            android:screenOrientation="landscape" />
            
        <!-- Movie Info Screen Activity -->
        <activity
            android:name=".ui.movieinfo.MovieInfoScreen"
            android:exported="false"
            android:theme="@style/Theme.NewIPTV.NoActionBar"
            android:screenOrientation="landscape" />
            
        <!-- History Screen Activity -->
        <activity
            android:name=".ui.history.HistoryScreen"
            android:exported="false"
            android:theme="@style/Theme.NewIPTV.NoActionBar"
            android:screenOrientation="landscape" />

        <!-- Favorites Screen Activity -->
        <activity
            android:name=".ui.favorites.FavoritesScreen"
            android:exported="false"
            android:theme="@style/Theme.NewIPTV.NoActionBar"
            android:screenOrientation="landscape" />

        <!-- Playlist Details Activity -->
        <activity
            android:name=".ui.favorites.PlaylistDetailsActivity"
            android:exported="false"
            android:theme="@style/Theme.NewIPTV.NoActionBar"
            android:screenOrientation="landscape" />

        <!-- Global Search Activity -->
        <activity
            android:name=".ui.search.GlobalSearchScreen"
            android:exported="false"
            android:theme="@style/Theme.NewIPTV.NoActionBar"
            android:screenOrientation="landscape" />
        
        <!-- Video Player Activity -->
        <activity
            android:name=".player.VideoPlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.NewIPTV.NoActionBar"
            android:screenOrientation="sensor" />
            
        <!-- MX Video Player Activity -->
        <activity
            android:name=".player.MXVideoPlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.NewIPTV.NoActionBar"
            android:screenOrientation="sensor" />
            
        <!-- Settings Activity -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.NewIPTV.NoActionBar"
            android:screenOrientation="landscape" />
            
    </application>

    <!-- Queries for MX Player detection -->
    <queries>
        <package android:name="com.mxtech.videoplayer.ad" />
    </queries>

</manifest>